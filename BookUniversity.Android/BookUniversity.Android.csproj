<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android34.0</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BookUniversity</RootNamespace>
    <AssemblyName>BookUniversity.Android</AssemblyName>
    <ApplicationId>com.blackout78.bookuniversity</ApplicationId>
    <ApplicationVersion>6</ApplicationVersion>
    <ApplicationDisplayVersion>0.6.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Android" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="PDFtoImage" Version="4.*" />
    <PackageReference Include="PdfPig" Version="0.1.*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\BookUniversity\AppInfo.cs" Link="Shared\AppInfo.cs" />
    <Compile Include="..\BookUniversity\LibraryStore.cs" Link="Shared\LibraryStore.cs" />
    <Compile Include="..\BookUniversity\BookmarkStore.cs" Link="Shared\BookmarkStore.cs" />
    <Compile Include="..\BookUniversity\PdfSearch.cs" Link="Shared\PdfSearch.cs" />
  </ItemGroup>
</Project>
