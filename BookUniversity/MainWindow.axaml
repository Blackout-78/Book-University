<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BookUniversity.MainWindow"
        Width="1280" Height="800" MinWidth="720" MinHeight="480"
        Background="#0E1320" Title="Book University">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="#161C2E" Padding="14,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StampText" Foreground="#A9B3CF" FontSize="11" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="ZoomOutButton" Content="−" Width="40" Height="40" />
          <TextBlock x:Name="ZoomText" Foreground="#E6E9F2" FontWeight="SemiBold" Width="56"
                     TextAlignment="Center" VerticalAlignment="Center" />
          <Button x:Name="ZoomInButton" Content="+" Width="40" Height="40" />
          <ToggleButton x:Name="ZoomLockButton" Content="Zoom lock" Height="40" />
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Top" Background="#161C2E" Padding="14,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Book University" Foreground="#E6E9F2" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <ToggleButton x:Name="NightButton" Grid.Column="1" Content="Night mode" Height="40" IsChecked="True" />
      </Grid>
    </Border>
    <Border Padding="24">
      <TextBlock Text="PDF rendering comes in the next build." Foreground="#A9B3CF"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </DockPanel>
</Window>
