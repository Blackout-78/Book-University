<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BookUniversity.MainWindow"
        Width="1280" Height="800" MinWidth="720" MinHeight="480"
        Background="#0E1320" Title="Book University">
  <Grid>
  <DockPanel x:Name="ReaderRoot" IsVisible="False">
    <Border DockPanel.Dock="Bottom" Background="#161C2E" Padding="14,8">
      <Grid ColumnDefinitions="*,Auto,*">
        <TextBlock x:Name="StampText" Foreground="#A9B3CF" FontSize="11" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <Button x:Name="PrevButton" Content="‹" Width="44" Height="40" />
          <TextBlock x:Name="PageText" Foreground="#E6E9F2" FontWeight="SemiBold" MinWidth="120"
                     TextAlignment="Center" VerticalAlignment="Center" />
          <Button x:Name="NextButton" Content="›" Width="44" Height="40" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="ZoomOutButton" Content="−" Width="40" Height="40" />
          <TextBox x:Name="ZoomBox" Width="64" Height="40" TextAlignment="Center" MaxLength="4" />
          <TextBlock Text="%" Foreground="#E6E9F2" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="ZoomInButton" Content="+" Width="40" Height="40" />
          <ToggleButton x:Name="ZoomLockButton" Content="Zoom lock" Height="40" />
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Top" Background="#161C2E" Padding="14,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <Button x:Name="BackButton" Content="‹ Library" Height="40" />
        <TextBlock x:Name="TitleText" Grid.Column="1" Text="Book University" Foreground="#E6E9F2"
                   FontSize="16" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center" />
        <TextBox x:Name="SearchBox" Margin="4,0" Grid.Column="2" Width="240" Height="40" Watermark="Search in book" />
        <Button x:Name="SearchButton" Margin="4,0" Grid.Column="3" Content="Search" Height="40" />
        <Button x:Name="BookmarkButton" Margin="4,0" Grid.Column="4" Content="☆ Bookmark" Height="40" />
        <ToggleButton x:Name="NightButton" Margin="4,0" Grid.Column="5" Content="Night mode" Height="40" IsChecked="True" />
      </Grid>
    </Border>
    <Border DockPanel.Dock="Left" Width="300" Background="#161C2E" BorderBrush="#263050" BorderThickness="0,0,1,0">
      <TabControl x:Name="SideTabs">
        <TabItem x:Name="ResultsTab" Header="Results">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button x:Name="PrevResultButton" Content="Previous" Height="40" />
              <Button x:Name="NextResultButton" Content="Next" Height="40" />
            </StackPanel>
            <ListBox x:Name="ResultsList" />
          </DockPanel>
        </TabItem>
        <TabItem x:Name="BookmarksTab" Header="Bookmarks">
          <ListBox x:Name="BookmarksList" />
        </TabItem>
      </TabControl>
    </Border>
    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Grid>
        <Image x:Name="PageImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24" />
        <TextBlock x:Name="StatusText" Text="Tap Open PDF to start." Foreground="#A9B3CF"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </ScrollViewer>
  </DockPanel>
  <DockPanel x:Name="LibraryRoot">
    <Border DockPanel.Dock="Bottom" Background="#161C2E" Padding="14,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="LibStampText" Foreground="#A9B3CF" FontSize="11" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="LibOpenButton" Content="Open" Height="40" Margin="4,0" />
          <Button x:Name="LibRemoveButton" Content="Remove" Height="40" Margin="4,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Top" Background="#161C2E" Padding="14,8">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Text="Library" Foreground="#E6E9F2" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBox x:Name="LibSearchBox" Grid.Column="1" Width="300" Height="40" Margin="4,0" Watermark="Search your library" />
        <Button x:Name="AddFilesButton" Grid.Column="2" Content="+ Add PDFs" Height="40" Margin="4,0" />
        <Button x:Name="AddFolderButton" Grid.Column="3" Content="Add folder" Height="40" Margin="4,0" />
      </Grid>
    </Border>
    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,4" Spacing="8">
      <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="SortRecent" Content="Recent" IsChecked="True" Margin="0,0,6,0" />
        <ToggleButton x:Name="SortName" Content="A to Z" Margin="0,0,6,0" />
        <ToggleButton x:Name="SortBookmarked" Content="Bookmarked" />
      </StackPanel>
      <TextBlock x:Name="LibStatus" Foreground="#A9B3CF" FontSize="13" TextWrapping="Wrap" />
    </StackPanel>
    <ListBox x:Name="LibList" Margin="14,4,14,8" />
  </DockPanel>
  </Grid>
</Window>
